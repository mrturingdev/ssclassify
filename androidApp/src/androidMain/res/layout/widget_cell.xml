<?xml version="1.0" encoding="utf-8"?>
<!-- One tile, styled like ImageCard in the app: crop, bottom gradient, badge, summary. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cell_root"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:layout_margin="3dp"
    android:background="@drawable/widget_cell_background"
    android:clipToOutline="true"
    tools:targetApi="31">

    <ImageView
        android:id="@+id/cell_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:id="@+id/cell_caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/widget_cell_scrim"
        android:orientation="vertical"
        android:paddingHorizontal="5dp"
        android:paddingTop="12dp"
        android:paddingBottom="5dp">

        <TextView
            android:id="@+id/cell_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_badge_background"
            android:ellipsize="end"
            android:maxLines="1"
            android:minWidth="32dp"
            android:paddingHorizontal="4dp"
            android:paddingVertical="1dp"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cell_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#FFFFFF"
            android:textSize="10sp" />
    </LinearLayout>
</FrameLayout>
